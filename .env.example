# Kopieren nach .env und Werte eintragen.
#
# Zwei Betriebsarten:
#  A) YAML-Modus: config/config.yaml existiert. Hier stehen dann nur die Secrets, deren Variablennamen
#     in der YAML unter *_env referenziert werden.
#  B) Env-Modus (Unraid, Portainer, docker run): keine config.yaml, alles kommt aus Variablen.
#     Aktiviert sich automatisch, sobald ACME_EMAIL gesetzt ist und keine config.yaml vorhanden ist.
#     "acme-helper show-config" zeigt die daraus erzeugte Konfiguration (ohne Secret-Werte).

# --- Secrets (beide Modi) ---------------------------------------------------
# Cloudflare API-Token mit Zone:DNS:Edit + Zone:Zone:Read für die betroffenen Zonen
CF_API_TOKEN=
# do.de / Domain-Offensive: Let's-Encrypt-Token aus my.do.de
DODE_TOKEN=
# Strato Kundenlogin (nur nötig, wenn der Provider "strato" ohne CNAME-Delegation genutzt wird)
STRATO_USER=
STRATO_PASS=
STRATO_TOTP_SECRET=
STRATO_TOTP_DEVICENAME=
# FortiWeb Admin mit REST-API-Zugriff
FW_USER=
FW_PASS=
# Optionaler Webhook für Benachrichtigungen (POST JSON)
NOTIFY_WEBHOOK=

# --- Nur Env-Modus (B) --------------------------------------------------------
# ACME_EMAIL=admin@example.com
# ACME_STAGING=true
# ACME_KEY_TYPE=ecdsa
# ZONES=example.com=cf;acme.example.net=dode;legacy-strato.de=strato
# FW_HOST=10.0.0.5
# FW_PORT=8443
# FW_VDOM=root
# FW_VERIFY_TLS=false
# CERT1_DOMAINS=example.com,*.example.com
# CERT1_PREFIX=wc-example-com
# CERT1_POLICIES=policy-web
# CERT1_SNI=sni-main:*.example.com|example.com
# CERT1_CHAIN_MODE=intermediate-group
# CERT1_KEEP_OLD=1
# CERT2_DOMAINS=*.legacy-strato.de,legacy-strato.de
# CERT2_POLICIES=policy-legacy
# SCHEDULE_TIME=03:30
# TZ=Europe/Berlin
# PUID=1000
# PGID=1000
