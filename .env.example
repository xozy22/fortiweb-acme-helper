# Kopieren nach .env und Werte eintragen. Die Variablennamen werden in config.yaml referenziert (*_env).

# Cloudflare API-Token mit Berechtigung Zone:DNS:Edit (+ Zone:Zone:Read) für die betroffenen Zonen
CF_API_TOKEN=

# do.de / Domain-Offensive: Let's Encrypt-Token aus my.do.de
DODE_TOKEN=

# Strato Kundenlogin (nur nötig, wenn der Provider "strato" ohne CNAME-Delegation genutzt wird)
STRATO_USER=
STRATO_PASS=
STRATO_TOTP_SECRET=

# FortiWeb Admin mit REST-API-Zugriff
FW1_USER=
FW1_PASS=

# Optionaler Webhook für Benachrichtigungen (POST JSON)
NOTIFY_WEBHOOK=
